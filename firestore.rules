rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Create admin membership manually in the Firebase Console.
    // Membership cannot be created or edited from the public website.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function validVisibility() {
      return request.resource.data.status in ['draft', 'published'];
    }

    match /news/{newsId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin() && validVisibility();
      allow delete: if isAdmin();
    }

    match /cases/{caseId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin() && validVisibility();
      allow delete: if isAdmin();
    }

    // Public inquiries: write-once only, never publicly readable.
    // Configure Firebase App Check / abuse protection before high-volume operation.
    match /inquiries/{inquiryId} {
      function validInquiry() {
        return request.resource.data.keys().hasOnly([
          'type','name','phone','email','message','category','details','consent','createdAt','status'
        ])
        && request.resource.data.keys().hasAll(['type','phone','email','message','consent','createdAt','status'])
        && request.resource.data.type in ['quick','general']
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 2
        && request.resource.data.message.size() <= 3000
        && request.resource.data.get('name','') is string
        && request.resource.data.get('category','') is string
        && request.resource.data.get('details','') is string
        && request.resource.data.get('details','').size() <= 4000
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      }
      allow create: if validInquiry();
      allow get, list, update, delete: if isAdmin();
    }


    // Anonymous pageview events are write-only for visitors, readable by admins.
    match /visitorEvents/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(['sessionId','path','createdAt'])
        && request.resource.data.keys().hasAll(['sessionId','path','createdAt'])
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() == 36
        && request.resource.data.path is string
        && request.resource.data.path.size() >= 1
        && request.resource.data.path.size() <= 180
        && request.resource.data.path.matches('^/[a-zA-Z0-9/_-]*$')
        && request.resource.data.createdAt == request.time;
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
